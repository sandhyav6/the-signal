# Dynamic News Feed — Environment Configuration
# Copy this file to .env and fill in your values.
# The app runs fully in mock mode with no .env file configured.

# ── News API ──────────────────────────────────────────────────────────────────
# Get a free key at https://newsapi.org/register
# Leave blank to run in mock mode (no API calls made).
NEWS_API_KEY=

# NewsAPI base URL (do not change unless NewsAPI changes their endpoint)
NEWS_API_URL=https://newsapi.org/v2

# ── Application ───────────────────────────────────────────────────────────────
# "mock" = use data/mock_articles.json only (default, no API key required)
# "live" = fetch from NewsAPI/RSS (requires NEWS_API_KEY)
APP_ENV=mock

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite database file path (relative to project root)
DATABASE_URL=sqlite:///./data/news.db

# ── Server ────────────────────────────────────────────────────────────────────
# FastAPI backend host and port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Streamlit frontend port
FRONTEND_PORT=8501
