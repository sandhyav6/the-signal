# The Signal — Environment Configuration
# Copy this file to .env and fill in your values.
# The app runs fully in mock mode with no .env file configured.

# ── News API ──────────────────────────────────────────────────────────────────
# Get a free key at https://newsapi.org/register
# Leave blank to run in mock mode (no API calls made).
NEWS_API_KEY=

# NewsAPI base URL (do not change unless NewsAPI changes their endpoint)
NEWS_API_URL=https://newsapi.org/v2

# Country for top headlines (2-letter code) and articles per category.
NEWS_API_COUNTRY=us
NEWS_API_PAGE_SIZE=40

# One refresh = 7 requests (6 categories + "general"). The free developer
# plan allows 100/day; past this budget refreshes serve stored articles.
NEWS_API_DAILY_BUDGET=90

# Minimum seconds between live fetches (refreshes inside it use the cache).
REFRESH_COOLDOWN_SECONDS=300

# Background refresh interval in live mode (0 = manual refresh only).
# 180 min = 8 refreshes/day = 56 requests, leaving room for manual ones.
AUTO_REFRESH_MINUTES=180

# ── Application ───────────────────────────────────────────────────────────────
# "mock" = use data/mock_articles.json only (default, no API key required)
# "live" = fetch from NewsAPI (requires NEWS_API_KEY); the UI starts in
#          live mode and the backend refreshes itself in the background
APP_ENV=mock

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite database file path (relative to project root)
DATABASE_URL=sqlite:///./data/news.db

# ── Server ────────────────────────────────────────────────────────────────────
# FastAPI backend host and port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Streamlit frontend port
FRONTEND_PORT=8501
